payments ||--o{ ledger_entries : financial movements
top_ups |o--o{ ledger_entries : top-up movements
biller_services ||--o{ fee_rules : fee rules
fee_rules ||--o{ fee_tiers : tiers
billers ||--o{ promotions : promotions
payments ||--o| commissions : may earn
accounts ||--o{ commissions : agent receives

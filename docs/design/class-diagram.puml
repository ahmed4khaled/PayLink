@startuml
title PayLink - Domain Class Diagram
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

' ---------- Shared kernel ----------
package "Shared Kernel" {
  class Money <<value>> {
    +amount : Decimal
    +currency : String
    +add(other : Money) : Money
    +subtract(other : Money) : Money
    +multiply(factor : Decimal) : Money
    +isNegative() : Boolean
  }
}

' ---------- Accounts and Wallet ----------
package "Accounts and Wallet" {
  enum AccountRole {
    CUSTOMER
    AGENT
    ADMIN
    SUPPORT
    SYSTEM
  }

  enum VerificationLevel {
    BASIC
    VERIFIED
  }

  enum LedgerEntryType {
    TOP_UP_CARD
    TOP_UP_AGENT_CASH
    HOLD
    RELEASE
    CAPTURE
    FEE_INCOME
    COMMISSION
    REFUND
  }

  enum BalanceBucket {
    AVAILABLE
    HELD
  }

  enum HoldResult {
    HELD
    INSUFFICIENT_AVAILABLE
  }

  enum TopUpMethod {
    CARD
    AGENT_CASH
  }

  enum TopUpStatus {
    PENDING
    COMPLETED
    FAILED
  }

  enum BlockReason {
    VELOCITY
    SUPPORT_MANUAL
  }

  class Account <<entity>> {
    +accountId : UUID
    +role : AccountRole
    +verificationLevel : VerificationLevel
    +createdAt : DateTime
    +isBlocked(at : DateTime) : Boolean
  }

  class Wallet <<entity>> {
    +walletId : UUID
    +accountId : UUID
    +createdAt : DateTime
    +/availableBalance : Money
    +/heldBalance : Money
  }

  class LedgerEntry <<entity>> {
    +entryId : UUID
    +movementId : UUID
    +walletId : UUID
    +type : LedgerEntryType
    +bucket : BalanceBucket
    +amount : Money
    +paymentId : UUID?
    +createdAt : DateTime
    +createdBy : UUID
    +reason : String
  }

  class FinancialMovement <<entity>> {
    +movementId : UUID
    +idempotencyKey : String
    +type : LedgerEntryType
    +paymentId : UUID?
    +refundPaymentId : UUID?
    +topUpId : UUID?
    +createdAt : DateTime
  }

  class TopUp <<entity>> {
    +topUpId : UUID
    +walletId : UUID
    +method : TopUpMethod
    +amount : Money
    +agentAccountId : UUID?
    +status : TopUpStatus
    +gatewayReference : String?
    +createdAt : DateTime
  }

  class AccountBlock <<entity>> {
    +blockId : UUID
    +accountId : UUID
    +reason : BlockReason
    +blockedAt : DateTime
    +blockedUntil : DateTime?
    +blockedBy : UUID?
    +unblockedAt : DateTime?
  }

  interface CardPaymentGateway {
    +charge(amount : Money, cardToken : String) : Boolean
  }

  class SimulatedCardGateway

  class AccountService <<service>> {
    +register() : Account
    +upgradeToVerified(accountId : UUID) : void
    +blockAccount(accountId : UUID, reason : BlockReason, until : DateTime?) : void
    +unblockAccount(accountId : UUID) : void
  }

  class WalletService <<service>> {
    +topUpByCard(walletId : UUID, amount : Money, cardToken : String) : TopUp
    +topUpByAgent(agentId : UUID, walletId : UUID, amount : Money) : TopUp
    +holdFunds(walletId : UUID, paymentId : UUID, totalAmount : Money) : HoldResult
    +captureFunds(paymentId : UUID) : void
    +releaseFunds(paymentId : UUID) : void
    +credit(walletId : UUID, amount : Money, type : LedgerEntryType, reason : String) : LedgerEntry
    +getTransactions(walletId : UUID) : List<LedgerEntry>
  }
}

' ---------- Authentication ----------
package "Authentication" {
  class AuthenticationRequest <<value>> {
    +loginIdentifier : String
    +password : Secret
  }

  class AuthenticatedPrincipal <<value>> {
    +accountId : UUID
    +authorities : Set<AccountRole>
  }

  class AccountCredentials <<entity>> {
    +credentialId : UUID
    +accountId : UUID
    +passwordHash : Argon2idHash
    +failedLoginAttempts : Integer
    +lockedUntil : DateTime?
    +passwordUpdatedAt : DateTime
    +createdAt : DateTime
    +updatedAt : DateTime
  }

  class LoginSession <<entity>> {
    +sessionId : UUID
    +accountId : UUID
    +tokenHash : String
    +createdAt : DateTime
    +expiresAt : DateTime
    +lastActivityAt : DateTime
    +revokedAt : DateTime?
    +ipAddress : String?
    +userAgent : String?
  }

  class SessionSummary <<value>> {
    +sessionId : UUID
    +createdAt : DateTime
    +expiresAt : DateTime
    +lastActivityAt : DateTime
    +ipAddress : String?
    +userAgent : String?
  }

  interface AuthenticationService {
    +authenticate(request : AuthenticationRequest) : AuthenticatedPrincipal
    +validateSession(rawToken : Secret) : AuthenticatedPrincipal
    +changePassword(accountId : UUID, currentPassword : Secret, newPassword : Secret) : void
    +initiatePasswordReset(identifier : String) : void
    +logout(sessionId : UUID) : void
    +logoutAll(accountId : UUID) : void
    +recordFailedLogin(accountId : UUID) : void
  }

  class SessionManager <<service>> {
    +createSession(accountId : UUID) : Secret
    +validateSession(rawToken : Secret) : AuthenticatedPrincipal?
    +activeSessions(accountId : UUID) : List<SessionSummary>
    +revokeSession(sessionId : UUID) : void
    +revokeAllActive(accountId : UUID) : void
  }

  interface AccountRepository <<repository>> {
    +findForAuthentication(identifier : String) : Account?
    +findById(accountId : UUID) : Account?
  }

  interface AccountCredentialsRepository <<repository>> {
    +findByAccountId(accountId : UUID) : AccountCredentials?
    +save(credentials : AccountCredentials) : void
  }

  interface LoginSessionRepository <<repository>> {
    +save(session : LoginSession) : void
    +findActiveByTokenHash(tokenHash : String) : LoginSession?
    +findActiveByAccountId(accountId : UUID) : List<LoginSession>
    +revoke(sessionId : UUID, at : DateTime) : void
    +revokeAllActive(accountId : UUID, at : DateTime) : void
  }

  interface "PasswordEncoder\n(org.springframework.security.crypto.password.PasswordEncoder)" as PasswordEncoder <<Spring Security>>
  class "Argon2PasswordEncoder\n(org.springframework.security.crypto.argon2.Argon2PasswordEncoder)" as Argon2PasswordEncoder <<Spring Security>>
  class AuthenticationFilter <<Spring Security>>
  class SecurityContext <<Spring Security>>

  AuthenticationService ..> PasswordEncoder : injected
  Argon2PasswordEncoder ..|> PasswordEncoder
  AuthenticationService ..> AccountRepository
  AuthenticationService ..> AccountCredentialsRepository
  AuthenticationService ..> SessionManager
  SessionManager ..> LoginSessionRepository
  AuthenticationFilter ..> SessionManager : extracts cookie token / validates
  AuthenticationFilter ..> SecurityContext : establishes identity and authorities
  AccountRepository ..> Account
  AccountCredentialsRepository ..> AccountCredentials
  LoginSessionRepository ..> LoginSession
  SessionManager ..> SessionSummary : returns without token hash
  Account "1" -- "0..1" AccountCredentials
  Account "1" -- "0..*" LoginSession
}

note right of AuthenticationService
  Authentication is implemented internally in PayLink; no external
  provider or JWT-only stateless session design is used. The existing
  Spring Security PasswordEncoder interface is injected through DI;
  Argon2PasswordEncoder is its configured implementation. No custom
  PasswordHasher or manual hashing implementation is introduced.
  loginIdentifier is a generic placeholder. The user approved deferring
  selection until account provisioning for all roles is defined (AQ-04,
  2026-11-25). This is not team/TA approval; do not assume phone, email,
  username, or another key. Rationale: the brief selects no credential key.
  Password reset policy also needs clarification.
end note

note right of SessionManager
  Generate cryptographically secure random session tokens. Return the
  raw value only to the authentication response/cookie path; persist
  only its secure hash. Reject unknown, expired, or revoked sessions.
  Active means not expired and not revoked. Revoke one or all sessions.
end note

note right of AuthenticationFilter
  Read the token from a Secure, HttpOnly cookie with an appropriate
  SameSite setting. Apply CSRF protection to cookie-authenticated state
  changes. Establish account identity and database-derived authorities
  in SecurityContext; never trust client-supplied roles.
end note


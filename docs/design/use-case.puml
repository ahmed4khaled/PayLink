@startuml
title PayLink - Use Case Diagram
left to right direction
skinparam shadowing false
skinparam nodesep 10
skinparam ranksep 70

' ---------- Primary actors ----------
actor "Customer" as Customer
actor "Agent" as Agent
actor "Administrator" as Admin
actor "Support Employee" as Support
actor "Scheduler\n(system timer)" as Timer

' ---------- Secondary actors ----------
actor "Payment Provider\n(simulated card)" as CardProvider
actor "Biller System\n(ElectroCo, AquaCo, TopUpNet)" as Biller
actor "NetCo\n(optional batch biller)" as NetCo
actor "Notification Provider\n(SMS / Push / Email)" as NotifProvider

rectangle "PayLink System" {
  usecase "Log In" as UC_Login
  usecase "Log Out" as UC_Logout
  usecase "Log Out from All Devices" as UC_LogoutAll
  usecase "Change Password" as UC_ChangePassword
  usecase "Reset Password" as UC_ResetPassword
  usecase "Register Account /\nComplete Account Registration" as UC_Register
  usecase "Upgrade Verification Level" as UC_Upgrade
  usecase "View Wallet Balance" as UC_Balance
  usecase "View Transaction History" as UC_History
  usecase "Top Up Wallet by Card" as UC_TopUpCard
  usecase "Top Up Wallet through Agent" as UC_TopUpAgent

  usecase "Browse Billers and Services" as UC_Browse
  usecase "Inquire Bill" as UC_Inquire
  usecase "View Fees and Total Amount" as UC_ViewFees
  usecase "Calculate Service Fee" as UC_Fee

  usecase "Pay Bill" as UC_Pay
  usecase "Validate Payment Request\n(service range and idempotency)" as UC_Validate
  usecase "Perform Fraud Checks\n(single limit, daily limit,\nvelocity, blocked)" as UC_Fraud
  usecase "Hold Wallet Funds" as UC_Hold
  usecase "Submit Payment to Biller" as UC_Submit
  usecase "Capture Held Funds\nafter Successful Payment" as UC_Capture
  usecase "Receive Biller Callback\n(TopUpNet)" as UC_Callback
  usecase "Retry Unknown Payment" as UC_Retry
  usecase "Inquire Biller Payment Status" as UC_StatusInquiry
  usecase "Release Held Funds\n(after confirmed failure)" as UC_Release
  usecase "Credit Agent Commission" as UC_Commission
  usecase "Track Payment Status" as UC_Track

  usecase "Send Payment Notification" as UC_Notify
  usecase "Deliver Notification" as UC_Deliver
  usecase "Retry Failed Notification" as UC_NotifyRetry

  usecase "Submit Refund Request\n(completed payment)" as UC_RefundReq
  usecase "Review Refund Request" as UC_RefundReview
  usecase "Approve or Reject Refund" as UC_RefundDecide
  usecase "Process Approved Refund\n(credit customer wallet)" as UC_ProcessRefund

  usecase "Manage Billers and Services" as UC_ManageBillers
  usecase "Configure Fees, Limits\nand Promotions" as UC_ConfigFees
  usecase "View Daily Statistics" as UC_Stats
  usecase "Search Payment by Reference\n(full history)" as UC_Search
  usecase "Block or Unblock Account" as UC_Block

  usecase "Reconcile Payment Records" as UC_Reconcile
  usecase "Prepare and Upload NetCo\nDaily Payments CSV (optional)" as UC_UploadNetCo
  usecase "Import Settlement Data" as UC_Import
  usecase "Review Reconciliation Reports" as UC_ReviewReport
}

